# Written by `neon env pull` into .env.local
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Vercel AI Gateway: `vercel env pull` provides VERCEL_OIDC_TOKEN, or set an API key
AI_GATEWAY_API_KEY=

# Bearer token Vercel Cron sends to /api/cron/daily
CRON_SECRET=

# Lowest deep-match verdict pushed in the daily digest: strong_fit | good_fit (default) | stretch
NOTIFY_MIN_RECOMMENDATION=
# Lowest confidence pushed in the daily digest: low (default) | medium | high
NOTIFY_MIN_CONFIDENCE=

# Agent web search (defaults: enabled, 3 queries per user, 25 pages per run)
DISCOVERY_ENABLED=
DISCOVERY_QUERIES_PER_USER=
DISCOVERY_MAX_PAGES=

# Comma-separated Telegram user ids allowed to use /stats
ADMIN_TELEGRAM_IDS=

# Optional Gmail connection (read-only). OAuth client from Google Cloud Console; redirect URI: <APP_BASE_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64 (`openssl rand -base64 32`); encrypts stored refresh tokens
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Public URL of the app; defaults to https://$VERCEL_PROJECT_PRODUCTION_URL
APP_BASE_URL=
