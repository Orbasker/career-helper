{
  "buildCommand": "bun run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/telegram.ts": {
      "includeFiles": "assets/fonts/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/match-notify",
      "schedule": "7,22,37,52 * * * *"
    }
  ]
}
